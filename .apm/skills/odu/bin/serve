#!/usr/bin/env bash
# Launch odu's MCP face — the shared-service bridge, and the only MCP face odu
# has. `odu mcp` speaks the one public vocabulary (run_start, run_wait,
# run_retry, run_cancel, log_read, plus the `service`, `runs` and `logTails`
# resources) that the browser and `odu surface` also project; it owns no verb of
# its own and no run authority of its own.
#
# The bridge dials the singleton web service and addresses EVERY registered run
# by run id, and `run_start` takes the checkout to run in as an explicit
# absolute path — so the directory an MCP host happens to launch this from is
# not load-bearing. If no service is listening it starts one in the background
# and waits for it to be ready, so a cold machine needs no separate setup step.
#
# odu itself is resolved through Nix, unpinned by default: `github:juspay/odu`
# at its current master, so the agent face tracks upstream rather than ageing
# behind a consumer-side pin. Self-contained — no surrounding devshell.
# Requires flakes (`experimental-features = nix-command flakes`).
#
# Override knobs (env vars):
#   ODU_FLAKE   — flake-ref for odu (default: github:juspay/odu). A consumer
#                 that pins odu — kolu, say — points this at its own pinned
#                 output, e.g. ODU_FLAKE=.#odu
set -euo pipefail
exec nix run --accept-flake-config "${ODU_FLAKE:-github:juspay/odu}" -- mcp "$@"
