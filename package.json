{
  "name": "odu",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "start": "bun src/cli/main.ts",
    "start:runner": "bun src/runner/main.ts --stdio",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test ./src",
    "test:e2e": "bun test ./tests/e2e"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.103",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentui/core": "^0.4.5",
    "@preact/signals-core": "^1.8.0",
    "@solid-primitives/scheduled": "^1.5.3",
    "@xterm/headless": "^6.0.0",
    "dequal": "^2.0.3",
    "effect": "4.0.0-beta.103",
    "neverthrow": "^8.2.0",
    "quick-lru": "^7.3.0",
    "solid-js": "^1.9.0",
    "split2": "^4.2.0",
    "ts-pattern": "^5.9.0"
  },
  "//overrides": "One effect instance, always. The @kolu/* sources are hydrated from the Nix store and resolve `effect` by walking up to this root node_modules (bunfig.toml explains the isolated-linker invariant), so a second copy arriving transitively would give kolu's _tag-based error narrowing two class realms to disagree about.",
  "overrides": {
    "effect": "4.0.0-beta.103",
    "@effect/platform-node": "4.0.0-beta.103"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "@types/split2": "^4.2.3",
    "typescript": "^5.8.0"
  }
}
