---
import "../styles/global.css";
import "../styles/docs.css";
import type { MarkdownHeading } from "astro";
import SiteChrome from "../components/SiteChrome.astro";
import { docsBySection, hrefOf, type DocsEntry } from "../lib/docs";

interface Props {
  entry: DocsEntry;
  headings: MarkdownHeading[];
}

const { entry, headings } = Astro.props;
const { title, description } = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const here = hrefOf(entry);
const canonical = new URL(here, Astro.site).href;
const groups = await docsBySection();
const onThisPage = headings.filter((h) => h.depth === 2);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#080b0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f7f5" media="(prefers-color-scheme: light)" />
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem("odu-theme");
          document.documentElement.dataset.theme =
            s || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        } catch (e) {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}/logo.svg`} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · odu`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <title>{title} · odu</title>
  </head>
  <body>
    <SiteChrome active="docs">
      <main class="shell docs-page">
        <div class="docs-layout">
          <nav class="docs-nav" aria-label="Documentation">
            {
              groups.map(({ section, pages }) => (
                <div class="docs-nav-group">
                  <span class="docs-nav-label">{section}</span>
                  {pages.map((page) => {
                    const href = hrefOf(page);
                    const current = href === here;
                    return (
                      <>
                        <a href={href} aria-current={current ? "page" : undefined}>
                          {page.data.title}
                        </a>
                        {current && onThisPage.length > 0 && (
                          <ul class="docs-nav-headings">
                            {onThisPage.map((h) => (
                              <li>
                                <a href={`#${h.slug}`}>{h.text}</a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </>
                    );
                  })}
                </div>
              ))
            }
          </nav>
          <div class="docs-content">
            <h1>{title}</h1>
            <slot />
          </div>
        </div>
      </main>
    </SiteChrome>
  </body>
</html>
