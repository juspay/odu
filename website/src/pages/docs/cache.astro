---
import "../../styles/global.css";
import "../../styles/docs.css";
import SiteChrome from "../../components/SiteChrome.astro";
import { Content as DocsContent } from "../../content/cache.md";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="odu binary cache — buckets, tokens, pushing, private reads, and garbage collection."
    />
    <meta name="theme-color" content="#080b0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f7f5" media="(prefers-color-scheme: light)" />
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem("odu-theme");
          document.documentElement.dataset.theme =
            s || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
        } catch (e) {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={`${base}/logo.svg`} />
    <link rel="canonical" href="https://odu.kolu.dev/docs/cache/" />
    <meta property="og:title" content="odu cache docs" />
    <meta
      property="og:description"
      content="Buckets, tokens, pushing, private reads, and garbage collection."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://odu.kolu.dev/docs/cache/" />
    <title>Nix binary cache · odu</title>
  </head>
  <body>
    <SiteChrome active="docs">
      <main class="shell docs-page">
        <div class="docs-layout">
          <aside class="docs-nav" aria-label="Documentation sections">
            <span class="docs-nav-label">On this page</span>
            <a href="#quick-start">Quick start</a>
            <a href="#configure-your-repo">Configure</a>
            <a href="#every-run-at-once-the-web-service">Web & remote access</a>
            <a href="#daily-workflow">Daily workflow</a>
            <a href="#coding-agents">Agents</a>
            <a href="#cli-reference">CLI reference</a>
            <a href="#troubleshooting">Troubleshooting</a>
          </aside>
          <div class="docs-content">
            <DocsContent />
          </div>
        </div>
      </main>
    </SiteChrome>
  </body>
</html>
