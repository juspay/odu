---
interface Props {
  active?: "home" | "docs";
}

const { active = "home" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const github = "https://github.com/juspay/odu";
---

<header class="shell site-nav">
  <a class="brand" href={`${base}/`} aria-label="odu home">
    <img class="brand-logo" src={`${base}/logo.svg`} width="28" height="28" alt="" />
    <span>odu</span>
  </a>
  <nav class="nav-links" aria-label="Primary">
    <a href={`${base}/#proof`}>Demos</a>
    <a href={`${base}/#quickstart`}>Quickstart</a>
    <a href={`${base}/docs/`} aria-current={active === "docs" ? "page" : undefined}>Docs</a>
    <a class="nav-github" href={github} target="_blank" rel="noreferrer">
      GitHub <span aria-hidden="true">↗</span>
    </a>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch theme">
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
      </svg>
    </button>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const btn = document.querySelector("[data-theme-toggle]");
  const stored = () => {
    try {
      return localStorage.getItem("odu-theme");
    } catch {
      return null;
    }
  };
  const label = () =>
    root.dataset.theme === "light" ? "Switch to dark theme" : "Switch to light theme";
  if (btn) {
    btn.setAttribute("aria-label", label());
    btn.addEventListener("click", () => {
      const next = root.dataset.theme === "light" ? "dark" : "light";
      root.dataset.theme = next;
      try {
        localStorage.setItem("odu-theme", next);
      } catch {}
      btn.setAttribute("aria-label", label());
    });
  }
  // Track the OS preference, but only while the visitor hasn't chosen explicitly.
  window
    .matchMedia("(prefers-color-scheme: light)")
    .addEventListener("change", (e) => {
      if (stored()) return;
      root.dataset.theme = e.matches ? "light" : "dark";
      if (btn) btn.setAttribute("aria-label", label());
    });
</script>

<slot />

<footer class="shell site-footer">
  <span>odu · ஓடு · run<br />AGPL-3.0-or-later</span>
  <span class="footer-links">
    <a href={github}>GitHub</a>
    <a href={`${base}/docs/`}>Docs</a>
    <a href="https://just.systems">just</a>
    <a href="https://kolu.dev/blog/odu/">Announcement</a>
    <a href={`${github}/issues`}>Issues</a>
  </span>
</footer>
